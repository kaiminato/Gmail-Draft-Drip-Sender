# Neon Postgres connection string (Vercel > Storage > Neon, or neon.tech).
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: https://YOUR-APP.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: one more Google account allowed to sign in, on top of the built-in
# list in src/lib/admins.ts. Further seats are added from the Settings page.
# ADMIN_EMAIL=you@gmail.com

# Shared secret the extensions send. Same value goes in extension/config.js.
# Generate with: openssl rand -hex 32
EXTENSION_API_KEY=
